{
  "name": "omp-guardian",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Policy-aware approval reviewer for Oh My Pi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist/",
    "assets/",
    "config/",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    "NOTICE",
    "LICENSE",
    "SECURITY.md"
  ],
  "license": "Apache-2.0",
  "author": "Warc0s",
  "homepage": "https://github.com/Warc0s/omp-guardian",
  "repository": {
    "type": "git",
    "url": "https://github.com/Warc0s/omp-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/Warc0s/omp-guardian/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "ai-agent",
    "agent-safety",
    "auto-approval",
    "permission-management",
    "llm",
    "codex-guardian",
    "policy-as-code",
    "typescript",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "omp": ">=17.2.12 <18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/bun": "^1.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "bun test",
    "test:stress": "bun test tests/stress.test.ts --timeout 30000",
    "test:runtime": "bun test tests/omp-*.test.ts --timeout 120000",
    "test:live": "bun tests/live-smoke.ts",
    "test:coverage": "bun test --coverage --coverage-reporter lcov --coverage-dir ./coverage && bun scripts/check-coverage.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  }
}
